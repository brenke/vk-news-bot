# --- VK ---
# Ключ доступа сообщества (Управление -> Настройки -> Работа с API -> Ключи доступа)
# Нужны права: messages (управление сообщениями). Токен пользователя НЕ подойдёт.
VK_TOKEN=

# Числовой ID сообщества (без минуса). Например, для vk.com/club12345678 -> 12345678
VK_GROUP_ID=

# Версия API и параметры LongPoll
VK_API_VERSION=5.199
VK_LONGPOLL_WAIT=25
VK_REQUEST_TIMEOUT_MS=20000

# --- DeepSeek (опционально, но рекомендуется) ---
# Если ключа нет — бот просто покажет заголовки и описания из RSS.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=25000
DEEPSEEK_MAX_TOKENS=1200

# --- Новости ---
# Сколько новостей отдавать в ответе
NEWS_MAX_ITEMS=5
# За какой период искать (часы)
NEWS_WINDOW_HOURS=72
# Сколько кандидатов отдавать модели на отбор
NEWS_MAX_CANDIDATES=24
# Часовой пояс для дат в сообщении
NEWS_TIME_ZONE=Europe/Moscow
# Кэш RSS (секунды): не дёргать СМИ на каждый запрос
NEWS_CACHE_TTL_SEC=300
# Кэш готового ответа по теме (секунды)
NEWS_RESPONSE_CACHE_SEC=180
# Таймаут загрузки одного фида и число параллельных загрузок
NEWS_REQUEST_TIMEOUT_MS=12000
NEWS_CONCURRENCY=6
# Свои списки источников и синонимов (пути относительно корня проекта)
NEWS_FEEDS_PATH=config/feeds.json
NEWS_SYNONYMS_PATH=config/synonyms.json

# --- Поведение бота ---
# Антифлуд: минимальный интервал между запросами в одной беседе (секунды)
BOT_COOLDOWN_SEC=10
# Максимальная длина темы
BOT_MAX_TOPIC_LENGTH=120
LOG_LEVEL=info
